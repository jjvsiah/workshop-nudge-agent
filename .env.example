# Model (Vercel AI Gateway) — required to run the agent
AI_GATEWAY_API_KEY=

# Who receives workshop-nudge emails (you)
ALERT_EMAIL=you@example.com
ALERT_FROM_EMAIL=Workshop Nudge <onboarding@resend.dev>
RESEND_API_KEY=

# Optional: booking link included in alert emails
BOOKING_LINK=https://cal.com/your-handle/30min

# Snowflake — leave unset to use built-in fixture accounts
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=VERCEL_CS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# Override table/view names if your warehouse differs
# SF_ACCOUNTS_TABLE=accounts
# SF_ACTIVITIES_TABLE=account_activities
# SF_NOTES_TABLE=account_notes
# SF_USAGE_TABLE=account_usage_signals
